# App
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=nestjs_scraper

# Redis (BullMQ + Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Proxy Provider (Bright Data / Oxylabs)
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=
# Pool of proxy endpoints (comma-separated)
PROXY_POOL=

# CAPTCHA Solving Service
CAPTCHA_API_KEY=
CAPTCHA_PROVIDER=2captcha

# Scraper Settings
SCRAPER_CONCURRENCY=3
SCRAPER_JOB_ATTEMPTS=3
SCRAPER_BACKOFF_DELAY=5000
SCRAPER_MIN_DELAY_MS=2000
SCRAPER_MAX_DELAY_MS=8000

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000
